---
import { ArrowRight, Download, Mail, Github, Linkedin, Terminal, Sparkles, CheckCircle2, ShieldCheck, Cpu } from 'lucide-astro';
import { portfolioData } from '../data/portfolioData';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Intro & Call to Actions -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-medium shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Open for Opportunities • Full-Stack & Mobile Lead</span>
        </div>

        <!-- Main Headline -->
        <div class="space-y-2">
          <h2 class="text-sm uppercase tracking-widest font-mono text-cyan-400 font-semibold">
            &gt; Ritik Parihar
          </h2>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1]">
            Architecting <span class="gradient-text">Type-Safe</span> &amp; High-Performance Apps.
          </h1>
        </div>

        <!-- Tagline & Description -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
          Full-stack and cross-platform Application Developer with <span class="text-white font-semibold">3+ years of experience</span> building production web and mobile platforms using <span class="text-cyan-400 font-medium">TypeScript</span>, <span class="text-cyan-400 font-medium">React Native</span>, <span class="text-cyan-400 font-medium">Next.js</span>, <span class="text-cyan-400 font-medium">Expo</span>, and <span class="text-cyan-400 font-medium">Astro</span>. Proven leader of cross-functional teams with an obsession for end-to-end type safety and developer productivity.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-cyan-500 text-slate-950 font-semibold text-sm hover:bg-cyan-400 transition-all shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:-translate-y-0.5"
          >
            <span>Explore Projects</span>
            <ArrowRight class="w-4 h-4" />
          </a>

          <a
            href={portfolioData.personal.resumeUrl}
            download="Ritik_Parihar_Resume.pdf"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-slate-900 border border-white/10 hover:border-cyan-500/40 text-slate-200 hover:text-white font-medium text-sm transition-all hover:bg-slate-800 hover:-translate-y-0.5"
          >
            <Download class="w-4 h-4 text-cyan-400" />
            <span>Download Resume</span>
          </a>

          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-slate-300 hover:text-cyan-400 font-medium text-sm transition-colors hover:bg-white/5"
          >
            <Mail class="w-4 h-4" />
            <span>Contact Me</span>
          </a>
        </div>

        <!-- Social Links & Direct Triggers -->
        <div class="flex items-center gap-4 pt-4 border-t border-white/5">
          <span class="text-xs font-mono text-slate-500">Find me on:</span>
          <div class="flex items-center gap-2">
            <a
              href={portfolioData.personal.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 px-2.5 py-1 text-xs rounded-md bg-white/5 text-slate-300 hover:text-white hover:bg-white/10 border border-white/5 transition-colors"
            >
              <Github class="w-3.5 h-3.5" />
              <span>GitHub</span>
            </a>
            <a
              href={portfolioData.personal.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1.5 px-2.5 py-1 text-xs rounded-md bg-white/5 text-slate-300 hover:text-white hover:bg-white/10 border border-white/5 transition-colors"
            >
              <Linkedin class="w-3.5 h-3.5 text-sky-400" />
              <span>LinkedIn</span>
            </a>
            <button
              type="button"
              onclick={`window.copyToClipboard('${portfolioData.personal.email}', 'Email')`}
              class="flex items-center gap-1.5 px-2.5 py-1 text-xs rounded-md bg-white/5 text-slate-300 hover:text-white hover:bg-white/10 border border-white/5 transition-colors cursor-pointer"
            >
              <Mail class="w-3.5 h-3.5 text-emerald-400" />
              <span>{portfolioData.personal.email}</span>
            </button>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Neovim Window Card -->
      <div class="lg:col-span-5">
        <div class="relative rounded-2xl glass-panel border border-white/10 p-1 shadow-2xl shadow-cyan-950/50">
          
          <!-- Window Header (Mac / Neovim style) -->
          <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/5 bg-slate-950/80 rounded-t-xl">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
              <span class="ml-2 text-xs font-mono text-slate-400 flex items-center gap-1.5">
                <Terminal class="w-3.5 h-3.5 text-cyan-400" />
                nvim ritik.config.ts
              </span>
            </div>
            <span class="text-[11px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
              NORMAL
            </span>
          </div>

          <!-- Code Window Body -->
          <div class="p-4 sm:p-5 font-mono text-xs sm:text-[13px] leading-relaxed text-slate-300 bg-slate-950/90 rounded-b-xl overflow-x-auto">
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">1</span>
              <span><span class="text-purple-400">export const</span> <span class="text-sky-300">developer</span> = &#123;</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">2</span>
              <span class="pl-4"><span class="text-slate-400">name:</span> <span class="text-emerald-300">'Ritik Parihar'</span>,</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">3</span>
              <span class="pl-4"><span class="text-slate-400">role:</span> <span class="text-emerald-300">'Team Lead &amp; Senior Developer'</span>,</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">4</span>
              <span class="pl-4"><span class="text-slate-400">experience:</span> <span class="text-amber-300">'3+ years'</span>,</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">5</span>
              <span class="pl-4"><span class="text-slate-400">location:</span> <span class="text-emerald-300">'Jodhpur, Rajasthan, India'</span>,</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">6</span>
              <span class="pl-4"><span class="text-slate-400">coreStack:</span> [</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">7</span>
              <span class="pl-8"><span class="text-cyan-300">'TypeScript'</span>, <span class="text-cyan-300">'React Native'</span>, <span class="text-cyan-300">'Next.js'</span>,</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">8</span>
              <span class="pl-8"><span class="text-cyan-300">'Expo'</span>, <span class="text-cyan-300">'Express'</span>, <span class="text-cyan-300">'Astro'</span>, <span class="text-cyan-300">'Docker'</span>, <span class="text-cyan-300">'tRPC'</span></span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">9</span>
              <span class="pl-4">],</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">10</span>
              <span class="pl-4"><span class="text-slate-400">architecture:</span> <span class="text-emerald-300">'End-to-End Type-Safe &amp; Monorepos'</span>,</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">11</span>
              <span class="pl-4"><span class="text-slate-400">tools:</span> [<span class="text-cyan-300">'Neovim'</span>, <span class="text-cyan-300">'tmux'</span>, <span class="text-cyan-300">'Git'</span>, <span class="text-cyan-300">'Bun'</span>],</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">12</span>
              <span class="pl-4"><span class="text-slate-400">teamsLed:</span> <span class="text-amber-300">3</span>,</span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">13</span>
              <span class="pl-4"><span class="text-slate-400">status:</span> <span class="text-emerald-400">'Ready for Impact 🚀'</span></span>
            </div>
            <div class="flex">
              <span class="text-slate-600 select-none pr-4 text-right w-6">14</span>
              <span>&#125;;</span>
            </div>
          </div>

          <!-- Bottom Statusline (Neovim Lua statusline style) -->
          <div class="flex items-center justify-between px-3 py-1 bg-slate-900 border-t border-white/5 text-[10px] font-mono text-slate-400 rounded-b-xl">
            <div class="flex items-center gap-2">
              <span class="text-cyan-400 font-semibold">● TS</span>
              <span>UTF-8</span>
            </div>
            <div class="flex items-center gap-2">
              <span>Ln 14, Col 2</span>
              <span class="text-emerald-400">100%</span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 pt-8 border-t border-white/10">
      {portfolioData.personal.stats.map((stat) => (
        <div class="glass-panel rounded-xl p-4 sm:p-5 text-center group hover:border-cyan-500/30 transition-all">
          <div class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight group-hover:text-cyan-400 transition-colors">
            {stat.value}
          </div>
          <div class="text-xs sm:text-sm font-medium text-slate-400 mt-1">
            {stat.label}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
