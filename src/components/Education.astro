---
import { GraduationCap, BookOpen, Calendar, MapPin, Award } from 'lucide-astro';
import { portfolioData } from '../data/portfolioData';
---

<section id="education" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="space-y-3 mb-12">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-cyan-400 uppercase tracking-widest">
        <span>// 05. Academic Background</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Education &amp; <span class="gradient-text">foundations</span>.
      </h2>
      <p class="text-slate-400 max-w-xl text-sm sm:text-base">
        Formal academic training in computer science, scientific methodology, and analytical problem-solving.
      </p>
    </div>

    <!-- Education Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {portfolioData.education.map((item) => (
        <div class="glass-panel glass-panel-hover rounded-2xl p-6 border border-white/5 flex flex-col justify-between">
          <div class="space-y-4">
            
            <div class="flex items-center justify-between">
              <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 flex items-center justify-center">
                <GraduationCap class="w-5 h-5" />
              </div>
              {item.current ? (
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  CURRENTLY PURSUING
                </span>
              ) : (
                <span class="font-mono text-xs text-slate-400">{item.period}</span>
              )}
            </div>

            <div class="space-y-1.5">
              <h3 class="text-lg font-bold text-white tracking-tight">
                {item.degree}
              </h3>
              <p class="text-sm font-medium text-cyan-300">
                {item.institution}
              </p>
              {item.field && (
                <p class="text-xs text-slate-400 leading-relaxed">
                  Focus: {item.field}
                </p>
              )}
            </div>

          </div>

          <div class="pt-4 mt-6 border-t border-white/5 flex items-center justify-between text-xs font-mono text-slate-500">
            <span>Verified Degree</span>
            {item.current && <span class="text-cyan-400">{item.period}</span>}
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
