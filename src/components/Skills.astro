---
import { Code2, Layers, Layout, Database, Network, Terminal, Search, CheckCircle } from 'lucide-astro';
import { portfolioData } from '../data/portfolioData';

const iconMap: Record<string, any> = {
  Code2,
  Layers,
  Layout,
  Database,
  Network,
  Terminal
};
---

<section id="skills" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-cyan-400 uppercase tracking-widest">
          <span>// 02. Technical Arsenal</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Tools, frameworks, and <span class="gradient-text">technologies</span> I command.
        </h2>
        <p class="text-sm sm:text-base text-slate-400 max-w-xl">
          Curated over 3+ years of production experience building high-traffic web applications, mobile suites, and type-safe backend systems.
        </p>
      </div>

      <!-- Quick Interactive Filter Search -->
      <div class="relative w-full md:w-72">
        <Search class="w-4 h-4 text-slate-500 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
        <input
          id="skill-search"
          type="text"
          placeholder="Filter skills (e.g. Docker, React, tRPC)..."
          class="w-full pl-9 pr-4 py-2 rounded-xl bg-slate-900/80 border border-white/10 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-cyan-500/50 focus:ring-1 focus:ring-cyan-500/50 transition-all"
        />
      </div>
    </div>

    <!-- Skills Grid Categories -->
    <div id="skills-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {portfolioData.skillsCategories.map((category) => {
        const IconComponent = iconMap[category.icon] || Code2;
        return (
          <div class="skill-category-card glass-panel glass-panel-hover rounded-2xl p-6 border border-white/5 flex flex-col justify-between transition-all">
            <div>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 flex items-center justify-center shrink-0">
                  <IconComponent class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="text-base font-bold text-white tracking-tight">{category.title}</h3>
                  <p class="text-[11px] text-slate-400">{category.description}</p>
                </div>
              </div>

              <!-- Skills Badges List -->
              <div class="flex flex-wrap gap-2 mt-4">
                {category.skills.map((skill) => (
                  <div class="skill-badge group/skill relative flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-950/80 border border-white/5 hover:border-cyan-500/40 text-xs font-mono text-slate-200 transition-all">
                    <span>{skill.name}</span>
                    {skill.tag && (
                      <span class="text-[9px] px-1 rounded bg-cyan-500/10 text-cyan-400 font-semibold uppercase">
                        {skill.tag}
                      </span>
                    )}
                    {skill.level === 'Expert' && (
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block" title="Expert Proficiency"></span>
                    )}
                  </div>
                ))}
              </div>
            </div>

            <!-- Category Footer Indicator -->
            <div class="mt-6 pt-3 border-t border-white/5 flex items-center justify-between text-[11px] font-mono text-slate-500">
              <span>{category.skills.length} tools</span>
              <span class="text-cyan-400/80">Production-Tested</span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Key Tooling Highlight: Neovim & Bun & Monorepos -->
    <div class="mt-12 glass-panel rounded-2xl p-6 border border-white/5 bg-gradient-to-r from-cyan-950/20 via-slate-900/40 to-emerald-950/20">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center md:text-left">
        <div class="space-y-1">
          <div class="font-mono text-xs text-cyan-400 font-semibold uppercase tracking-wider">Editor of Choice</div>
          <div class="text-white font-bold text-base">Neovim &amp; tmux Power User</div>
          <p class="text-xs text-slate-400">Blazing fast keyboard-first editing, custom Lua configurations, and zero-distraction terminal workflow.</p>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-xs text-emerald-400 font-semibold uppercase tracking-wider">Fast Execution</div>
          <div class="text-white font-bold text-base">Bun, Vite &amp; Turborepo</div>
          <p class="text-xs text-slate-400">Leveraging high-speed JavaScript/TypeScript runtimes and optimized bundlers for instant hot-reload and fast builds.</p>
        </div>
        <div class="space-y-1">
          <div class="font-mono text-xs text-indigo-400 font-semibold uppercase tracking-wider">Data Integrity</div>
          <div class="text-white font-bold text-base">End-to-End Type Safety</div>
          <p class="text-xs text-slate-400">Strict tRPC APIs and Drizzle/Prisma models shared across cross-platform mobile and web applications.</p>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  const searchInput = document.getElementById('skill-search') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.skill-category-card');

  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase().trim();

    cards.forEach((card) => {
      const badges = card.querySelectorAll('.skill-badge');
      let hasMatch = false;

      badges.forEach((badge) => {
        const text = badge.textContent?.toLowerCase() || '';
        if (query === '' || text.includes(query)) {
          (badge as HTMLElement).style.display = 'inline-flex';
          hasMatch = true;
        } else {
          (badge as HTMLElement).style.display = 'none';
        }
      });

      if (hasMatch || query === '') {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  });
</script>
