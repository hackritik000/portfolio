---
import { Briefcase, Calendar, MapPin, Users, CheckCircle2, ChevronRight, Zap } from 'lucide-astro';
import { portfolioData } from '../data/portfolioData';
---

<section id="experience" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="space-y-3 mb-16">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-cyan-400 uppercase tracking-widest">
        <span>// 03. Engineering Journey</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Work experience &amp; <span class="gradient-text">leadership roles</span>.
      </h2>
      <p class="text-slate-400 max-w-2xl text-sm sm:text-base">
        Over 3 years of directing teams, driving architectural modernizations, and delivering production applications under rigorous deadlines.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative border-l-2 border-slate-800 ml-4 md:ml-32 space-y-12">
      {portfolioData.experience.map((exp, index) => (
        <div class="relative pl-6 md:pl-10 group">
          
          <!-- Timeline Node Dot -->
          <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-[#080c14] border-2 border-cyan-400 group-hover:scale-125 group-hover:bg-cyan-400 transition-all shadow-sm shadow-cyan-400">
            {exp.current && (
              <span class="absolute -inset-1 rounded-full bg-cyan-400/30 animate-ping"></span>
            )}
          </div>

          <!-- Desktop Period Badge (Left Offset) -->
          <div class="hidden md:block absolute -left-36 top-1 text-right w-28 font-mono text-xs text-slate-400 font-medium">
            {exp.period}
          </div>

          <!-- Main Card -->
          <div class="glass-panel glass-panel-hover rounded-2xl p-6 sm:p-7 border border-white/5 space-y-4">
            
            <!-- Card Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/5 pb-4">
              <div>
                <div class="flex flex-wrap items-center gap-2.5">
                  <h3 class="text-xl font-bold text-white tracking-tight group-hover:text-cyan-400 transition-colors">
                    {exp.role}
                  </h3>
                  {exp.current && (
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      CURRENT
                    </span>
                  )}
                  {exp.teamSize && (
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                      <Users class="w-3 h-3" />
                      <span>Led {exp.teamSize}</span>
                    </span>
                  )}
                </div>

                <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-1 text-xs sm:text-sm text-slate-400">
                  <span class="text-cyan-300 font-semibold">{exp.company}</span>
                  <span>•</span>
                  <span class="inline-flex items-center gap-1">
                    <MapPin class="w-3.5 h-3.5 text-slate-500" />
                    <span>{exp.location}</span>
                  </span>
                  <span class="md:hidden">•</span>
                  <span class="md:hidden font-mono text-xs text-slate-400">{exp.period}</span>
                </div>
              </div>

              <div class="text-xs font-mono text-slate-500 self-start sm:self-auto px-2.5 py-1 rounded bg-white/5 border border-white/5">
                {exp.type}
              </div>
            </div>

            <!-- Role Summary -->
            <p class="text-slate-300 text-sm leading-relaxed">
              {exp.summary}
            </p>

            <!-- Key Achievements Highlights -->
            <div class="space-y-2 pt-1">
              <div class="text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold">
                Key Accomplishments:
              </div>
              <ul class="space-y-2">
                {exp.highlights.map((highlight) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-300 leading-normal">
                    <CheckCircle2 class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Tech Stack Tags -->
            <div class="pt-4 border-t border-white/5 flex flex-wrap items-center gap-2">
              <span class="text-[11px] font-mono text-slate-500 mr-1">Stack:</span>
              {exp.skills.map((skill) => (
                <span class="px-2.5 py-1 rounded-md bg-slate-950/70 border border-white/5 text-[11px] font-mono text-slate-300 hover:border-cyan-500/30 transition-colors">
                  {skill}
                </span>
              ))}
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>
