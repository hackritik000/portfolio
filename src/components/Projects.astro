---
import { ExternalLink, Github, Smartphone, Globe, Layers, ArrowUpRight, CheckCircle2, Star, Sparkles } from 'lucide-astro';
import { portfolioData } from '../data/portfolioData';

const categories = [
  { id: 'all', label: 'All Projects' },
  { id: 'mobile', label: 'Mobile & Cross-Platform' },
  { id: 'fullstack', label: 'Full-Stack & Systems' },
  { id: 'web', label: 'Web & Performance' }
];
---

<section id="projects" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header & Filter Tabs -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-cyan-400 uppercase tracking-widest">
          <span>// 04. Selected Works</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Production software &amp; <span class="gradient-text">engineered systems</span>.
        </h2>
        <p class="text-slate-400 max-w-xl text-sm sm:text-base">
          Real-world applications engineered for scale, reliability, and high developer ergonomics.
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-2 p-1.5 rounded-xl bg-slate-900/80 border border-white/5 backdrop-blur-md">
        {categories.map((cat, i) => (
          <button
            type="button"
            data-filter={cat.id}
            class={`project-filter-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer ${
              i === 0
                ? 'bg-cyan-500 text-slate-950 font-semibold shadow-sm'
                : 'text-slate-400 hover:text-white hover:bg-white/5'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {portfolioData.projects.map((project) => (
        <div
          data-category={project.category}
          class="project-card glass-panel glass-panel-hover rounded-2xl p-7 border border-white/5 flex flex-col justify-between transition-all"
        >
          <div class="space-y-5">
            
            <!-- Card Top Metadata: Platform & Period -->
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                {project.platform?.toLowerCase().includes('apple') || project.platform?.toLowerCase().includes('mobile') || project.platform?.toLowerCase().includes('react native') ? (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-purple-500/10 text-purple-400 border border-purple-500/20 text-xs font-mono font-medium">
                    <Smartphone class="w-3.5 h-3.5" />
                    <span>{project.platform || 'Mobile & Cross-Platform'}</span>
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 text-xs font-mono font-medium">
                    <Globe class="w-3.5 h-3.5" />
                    <span>{project.platform || 'Full-Stack Web'}</span>
                  </span>
                )}
                {project.featured && (
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-amber-500/10 text-amber-300 border border-amber-500/20">
                    <Star class="w-3 h-3 fill-amber-300" />
                    FEATURED
                  </span>
                )}
              </div>

              <span class="font-mono text-xs text-slate-400">{project.period}</span>
            </div>

            <!-- Title & Subtitle -->
            <div class="space-y-1">
              <h3 class="text-2xl font-bold text-white tracking-tight group-hover:text-cyan-400 transition-colors flex items-center justify-between">
                <span>{project.title}</span>
              </h3>
              <p class="text-sm font-medium text-cyan-300/90 font-mono">
                {project.subtitle}
              </p>
            </div>

            <!-- Description -->
            <p class="text-sm text-slate-300 leading-relaxed">
              {project.description}
            </p>

            <!-- Highlights Checklist -->
            <div class="space-y-2 pt-2">
              <div class="text-[11px] font-mono uppercase tracking-wider text-slate-400 font-semibold">
                Architecture Highlights:
              </div>
              <ul class="space-y-2">
                {project.highlights.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs text-slate-300 leading-relaxed">
                    <CheckCircle2 class="w-3.5 h-3.5 text-cyan-400 shrink-0 mt-0.5" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 pt-2">
              {project.tags.map((tag) => (
                <span class="px-2.5 py-1 rounded-md bg-slate-950/70 text-slate-300 text-[11px] font-mono border border-white/5">
                  {tag}
                </span>
              ))}
            </div>

          </div>

          <!-- Bottom Action Buttons -->
          <div class="pt-6 mt-6 border-t border-white/5 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              {project.links?.appstore && (
                <a
                  href={project.links.appstore}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800/90 hover:bg-slate-700/90 text-white text-xs font-semibold border border-white/20 transition-all shadow-sm"
                >
                  <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
                    <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 1.01-2.87-.96.04-2.13.64-2.79 1.41-.58.68-1.1 1.74-1.01 2.78 1.07.08 2.17-.57 2.79-1.32z"/>
                  </svg>
                  <span>App Store</span>
                  <ArrowUpRight class="w-3 h-3 text-slate-400" />
                </a>
              )}
              {project.links?.playstore && (
                <a
                  href={project.links.playstore}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 hover:text-emerald-200 text-xs font-semibold border border-emerald-500/30 transition-all shadow-sm shadow-emerald-500/10"
                >
                  <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
                    <path d="M3.609 1.814L13.793 12 3.61 22.186a2.023 2.023 0 0 1-.22-.32 2.11 2.11 0 0 1-.168-.838V2.972c0-.309.058-.59.168-.838.06-.13.134-.238.22-.32zm1.434-.848a2.128 2.128 0 0 1 1.25.109l11.458 6.54-3.328 3.33-9.38-9.979zm0 22.068l9.38-9.979 3.328 3.33-11.458 6.54a2.128 2.128 0 0 1-1.25.109zm11.47-7.742l3.208-1.832c1.077-.615 1.077-1.619 0-2.234l-3.208-1.832-3.13 3.13 3.13 3.13z"/>
                  </svg>
                  <span>Google Play</span>
                  <ArrowUpRight class="w-3 h-3" />
                </a>
              )}
              {project.links?.website && (
                <a
                  href={project.links.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 text-xs font-semibold border border-cyan-500/30 transition-colors"
                >
                  <Globe class="w-3.5 h-3.5 shrink-0" />
                  <span>{project.id === 'performance-platforms' ? 'Live Platform' : 'Website'}</span>
                  <ArrowUpRight class="w-3 h-3" />
                </a>
              )}
              {project.links?.live && !project.links?.website && (
                <a
                  href={project.links.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 text-xs font-semibold border border-cyan-500/30 transition-colors"
                >
                  <span>{project.links?.demo ? 'Live Demo' : 'Live Platform'}</span>
                  <ArrowUpRight class="w-3.5 h-3.5" />
                </a>
              )}
              {project.links?.github && (
                <a
                  href={project.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 hover:text-white text-xs font-medium transition-colors"
                >
                  <Github class="w-3.5 h-3.5 shrink-0" />
                  <span>Repository</span>
                </a>
              )}
            </div>

            <button
              type="button"
              onclick={`window.copyToClipboard('${project.title} - ${project.links?.website || project.links?.playstore || 'hackritik000'}', 'Project Details')`}
              class="text-[11px] font-mono text-slate-500 hover:text-slate-300 transition-colors cursor-pointer"
            >
              Share
            </button>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.project-filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') || 'all';

      // Update button styles
      filterBtns.forEach((b) => {
        b.classList.remove('bg-cyan-500', 'text-slate-950', 'font-semibold', 'shadow-sm');
        b.classList.add('text-slate-400');
      });
      btn.classList.add('bg-cyan-500', 'text-slate-950', 'font-semibold', 'shadow-sm');
      btn.classList.remove('text-slate-400');

      // Filter cards
      projectCards.forEach((card) => {
        const cat = card.getAttribute('data-category') || '';
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
