---
import { FileText, Github, Linkedin, Menu, X, Terminal, ExternalLink } from 'lucide-astro';
import { portfolioData } from '../data/portfolioData';

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#skills', label: 'Skills' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#terminal', label: 'Terminal', badge: 'Neovim' },
  { href: '#contact', label: 'Contact' }
];
---

<header class="sticky top-0 z-40 w-full transition-all duration-300 border-b border-white/5 bg-[#080c14]/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="#" class="group flex items-center gap-2.5 font-mono text-base font-bold text-white transition-colors">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500 to-emerald-500 p-[1px] flex items-center justify-center shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform">
        <div class="w-full h-full bg-slate-950 rounded-[7px] flex items-center justify-center font-bold text-xs text-cyan-400">
          &gt;_
        </div>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="tracking-tight text-white group-hover:text-cyan-400 transition-colors">ritik</span>
        <span class="text-cyan-400">.</span>
        <span class="text-slate-400 font-normal text-sm">parihar()</span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="relative px-3 py-1.5 text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors rounded-lg hover:bg-white/5 flex items-center gap-1.5"
        >
          {link.label}
          {link.badge && (
            <span class="text-[10px] font-mono font-semibold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              {link.badge}
            </span>
          )}
        </a>
      ))}
    </nav>

    <!-- Right Side Actions: Socials & Resume CTA -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href={portfolioData.personal.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="p-2 text-slate-400 hover:text-white hover:bg-white/5 rounded-lg transition-colors"
      >
        <Github class="w-4 h-4" />
      </a>
      <a
        href={portfolioData.personal.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="p-2 text-slate-400 hover:text-white hover:bg-white/5 rounded-lg transition-colors"
      >
        <Linkedin class="w-4 h-4" />
      </a>

      <!-- Resume Button -->
      <a
        href={portfolioData.personal.resumeUrl}
        download="Ritik_Parihar_Resume.pdf"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 hover:bg-cyan-500/20 hover:border-cyan-500/50 transition-all shadow-sm shadow-cyan-500/10"
      >
        <FileText class="w-3.5 h-3.5" />
        <span>Resume</span>
      </a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button
      id="mobile-menu-btn"
      type="button"
      aria-label="Toggle navigation menu"
      class="md:hidden p-2 text-slate-400 hover:text-white hover:bg-white/5 rounded-lg transition-colors"
    >
      <Menu id="menu-icon" class="w-6 h-6" />
      <X id="close-icon" class="w-6 h-6 hidden" />
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-white/10 bg-[#0b101c]/95 backdrop-blur-xl px-4 pt-2 pb-6 space-y-2">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-item flex items-center justify-between px-3 py-2.5 text-base font-medium text-slate-200 hover:text-cyan-400 hover:bg-white/5 rounded-lg transition-colors"
      >
        <span>{link.label}</span>
        {link.badge && (
          <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            {link.badge}
          </span>
        )}
      </a>
    ))}

    <div class="pt-4 border-t border-white/10 flex flex-col gap-3">
      <a
        href={portfolioData.personal.resumeUrl}
        download="Ritik_Parihar_Resume.pdf"
        class="flex items-center justify-center gap-2 w-full py-2.5 text-sm font-semibold rounded-lg bg-cyan-500 text-slate-950 hover:bg-cyan-400 transition-colors"
      >
        <FileText class="w-4 h-4" />
        <span>Download Resume (PDF)</span>
      </a>

      <div class="flex items-center justify-center gap-4 pt-2 text-slate-400">
        <a href={portfolioData.personal.github} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-xs hover:text-white">
          <Github class="w-4 h-4" /> GitHub
        </a>
        <span>•</span>
        <a href={portfolioData.personal.linkedin} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-xs hover:text-white">
          <Linkedin class="w-4 h-4" /> LinkedIn
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileNavItems = document.querySelectorAll('.mobile-nav-item');

  function toggleMenu() {
    if (!menu || !menuIcon || !closeIcon) return;
    const isHidden = menu.classList.contains('hidden');
    if (isHidden) {
      menu.classList.remove('hidden');
      menuIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    } else {
      menu.classList.add('hidden');
      menuIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);
  mobileNavItems.forEach((item) => {
    item.addEventListener('click', () => {
      menu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
